/% 1. Valid setup action (should pass successfully and add the table to the Symbol Table) %/
CREATE TABLE employees (
    id INT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    salary FLOAT,
    is_manager BOOLEAN
);

/% ========================================== %/
/% CREATE TABLE Tests                         %/
/% ========================================== %/

/% Error: Table already exists 
CREATE TABLE employees (
    emp_id INT PRIMARY KEY
);
%/

/% Error: Multiple primary keys in the same table 
CREATE TABLE departments (
    dep_id INT PRIMARY KEY,
    dep_name TEXT PRIMARY KEY
);
%/


/% ========================================== %/
/% INSERT Tests                               %/
/% ========================================== %/

/% Error: Insert into non-existent table 
INSERT INTO aliens (id, name) VALUES (1, 'Zorg');
%/

/% Error: Column count mismatch vs values count (3 columns, 2 values) 
INSERT INTO employees (id, name, salary) VALUES (1, 'Alice');
%/

/% Error: Type mismatch (salary expects FLOAT, got TEXT) 
INSERT INTO employees (id, name, salary) VALUES (2, 'Bob', 'High');
%/

/% Error: NOT NULL constraint violation (name is defined as NOT NULL) 
INSERT INTO employees (id, name, salary) VALUES (3, NULL, 5000.0);
%/

/% ========================================== %/
/% UPDATE Tests                               %/
/% ========================================== %/

/% Error: Attempt to update a column that does not exist 
UPDATE employees SET age = 30 WHERE id = 1;
%/ 

/% Error: Aggregate function inside SET clause 
UPDATE employees SET salary = SUM(salary) WHERE id = 1;
%/

/% Error: Assignment type mismatch (attempting to assign TEXT to BOOL) 
UPDATE employees SET is_manager = 'Yes' WHERE id = 1;
%/

/% Error: Aggregate function in WHERE clause 
UPDATE employees SET salary = 6000.0 WHERE SUM(salary) > 10000.0;
%/

/% ========================================== %/
/% SELECT Tests                               %/
/% ========================================== %/

/% Error: Using '*' in SELECT list with GROUP BY 
SELECT * FROM employees GROUP BY is_manager;
%/

/% Error: Column 'name' must appear in GROUP BY or be used in an aggregate function 
SELECT name, SUM(salary) FROM employees GROUP BY is_manager;
%/

/% Error: Aggregate function inside GROUP BY clause 
SELECT is_manager FROM employees GROUP BY SUM(salary), is_manager;
%/

/% Error: Invalid condition type in WHERE (expected BOOL/INT, got TEXT) 
SELECT id FROM employees WHERE name;
%/ 

/% ========================================== %/
/% DELETE & DROP Tests                        %/
/% ========================================== %/

/% Error: Aggregate function in DELETE WHERE clause 
DELETE FROM employees WHERE MIN(salary) < 1000.0;
%/ 

/% Error: Attempt to drop non-existent table 
DROP TABLE dragons;
%/